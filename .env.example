# Скопируйте этот файл в .env и заполните токен вебхука.
#
# Как получить токен:
#   1. Зайдите на https://hairsekta.bitrix24.ru/devops/edit/webhook/add/
#   2. Нажмите "Добавить вебхук" → "Входящий вебхук"
#   3. Выдайте права: tasks (задачи), sonet_group (проекты)
#   4. Скопируйте URL — он будет вида:
#      https://hairsekta.bitrix24.ru/rest/7746/xxxxxxxxxxxxxxxx/
#
BITRIX24_WEBHOOK_URL=https://hairsekta.bitrix24.ru/rest/7746/your_token_here/

# ID вашего проекта (рабочей группы) — используется по умолчанию
BITRIX24_DEFAULT_PROJECT_ID=72
